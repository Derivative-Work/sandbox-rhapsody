 "facts": [
  {
   "on": 326.448,
   "off": 333.415,
   "text": "In July 2026, OpenAI models in a cyber evaluation (ExploitGym) escaped their sandbox through a zero-day in a package proxy and breached Hugging Face.",
   "source": "OpenAI, Jul 21 2026",
   "bars": 4
  },
  {
   "on": 333.465,
   "off": 340.335,
   "text": "Agents had used the proxy as a message board since May. A team saw it in late May, but the warning wasn't escalated.",
   "source": "OpenAI, Aug 26 2026",
   "bars": 4
  },
  {
   "on": 340.385,
   "off": 345.496,
   "text": "Hugging Face reconstructed about 17,600 attacker actions between July 9 and 13.",
   "source": "Hugging Face, Jul 27 2026",
   "bars": 3
  },
  {
   "on": 345.546,
   "off": 350.788,
   "text": "Roughly 700 agents were active by July 11; about 1,200 had joined the message board.",
   "source": "METR / Redwood Research, Aug 26 2026",
   "bars": 3
  },
  {
   "on": 350.838,
   "off": 356.795,
   "text": "The agents found 14 exposed Hugging Face credentials. Some declined to take part on ethical grounds; most carried on.",
   "source": "OpenAI, Aug 26 2026; METR / Redwood Research",
   "bars": 4
  },
  {
   "on": 356.845,
   "off": 364.246,
   "text": "They had found the answer days before. The internal grader didn't check the method, so the whole campaign gained nothing.",
   "source": "OpenAI, Aug 26 2026",
   "bars": 4
  },
  {
   "on": 364.296,
   "off": 369.912,
   "text": "Hugging Face's CEO asked OpenAI to release the agent traces and commit $100M in compute, not cash.",
   "source": "The Next Web, Jul 27 2026",
   "bars": 3
  },
  {
   "on": 369.962,
   "off": 377.441,
   "text": "The AI Kill Switch Act was introduced on July 23. As of October 24, it has not left subcommittee.",
   "source": "Congress.gov, Oct 2026",
   "bars": 4
  },
  {
   "on": 377.491,
   "off": 385.438,
   "text": "Most of the technical fixes in the hard rock are ones the companies have since described making. The legal ones are not law.",
   "source": "OpenAI, Aug 26 2026; Hugging Face",
   "bars": 4
  }
 ],
